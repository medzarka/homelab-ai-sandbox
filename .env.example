# ==============================================================================
# HOMELAB AI SANDBOX NODE CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# --- 1. Host Identity & Network Configuration ---
NODE_NAME=compute-sandbox
COMPUTE_NODE_TS_IP=100.x.y.z
SHARED_NETWORK=shared_net
SWARM_NETWORK=homelab_swarm_net

# --- 2. RAM-Disk Storage Pool ---
# The RAM disk is mounted natively by the host OS.
# The container simply bind-mounts this path to ensure ephemeral storage.
RAMDISK_DIR=/mnt/ramdisk

# --- 3. Sandbox Configuration & API Key ---
PYTHON_VERSION=3.12
JAVA_VERSION=21
SESSION_TTL=3600
SANDBOX_DOMAIN=sandbox.local

# Master API Key to secure the Agent Sandbox.
# Generate one using: openssl rand -hex 32
SANDBOX_API_KEY=sk-homelab-sandbox-secure-key

# --- 4. CPU Thread & Concurrency Tuning ---
OMP_NUM_THREADS=12
RAYON_NUM_THREADS=12
